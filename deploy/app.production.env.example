# Public browser configuration; these values are embedded in the client bundle.
VITE_SUPABASE_URL=https://api.example.com
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-SUPABASE_PUBLISHABLE_KEY-from-self-hosted-stack

# Server runtime configuration. Keep the service-role key private.
# The official Supabase Docker stack exposes api-gw on the private
# supabase_default network; use its SUPABASE_SECRET_KEY here.
SUPABASE_URL=http://api-gw:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-SUPABASE_SECRET_KEY-from-self-hosted-stack

# Both public DNS records must point to the production server.
APP_DOMAIN=erp.example.com
SUPABASE_DOMAIN=api.example.com

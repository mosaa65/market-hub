# Public browser configuration; these values are embedded in the client bundle.
VITE_SUPABASE_URL=https://your-supabase-domain.example
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server runtime configuration. Keep the service-role key private.
# For a separately deployed Supabase stack, use its private HTTPS URL or
# internal Docker network address reachable by this app.
SUPABASE_URL=https://your-supabase-domain.example
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-unique-service-role-secret

# Public DNS name pointed at this server.
APP_DOMAIN=erp.example.com

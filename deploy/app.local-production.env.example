# Local-only app access from this Windows PC.
VITE_SUPABASE_TARGET=docker
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=generated-from-local-self-hosted-stack

# Internal Docker URL for server-side calls. Keep the secret key private.
SUPABASE_TARGET=docker
SUPABASE_URL=http://api-gw:8000
SUPABASE_PUBLISHABLE_KEY=generated-from-local-self-hosted-stack
SUPABASE_SECRET_KEY=generated-from-local-self-hosted-stack

# These hostnames satisfy the shared Compose config; local production does not
# start Caddy or publish these hostnames.
APP_DOMAIN=app.localhost
SUPABASE_DOMAIN=api.localhost

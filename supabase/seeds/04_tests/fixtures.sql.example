-- ============================================================================
-- fixtures.sql.example — قالب مثبتات الاختبارات
-- ============================================================================
--
-- انسخ هذا الملف باسم جديد في نفس المجلد، واملأه.
--   cp fixtures.sql.example sales-fixtures.sql
--
-- ⚠️  مثبتات اختبار — تُشغَّل من الاختبارات الآلية فقط، ولا تُشغَّل على قاعدة عميل.
--
-- ── الغرض ───────────────────────────────────────────────────────────────────
--   بيانات ثابتة تجعل نتيجة الاختبار قابلة للتكرار. الاختبار الذي يعتمد على
--   now() أو على UUID عشوائي ينجح اليوم ويفشل غدًا.
--
-- ── الفرق عن ملفات 03_samples ───────────────────────────────────────────────
--   في العيّنات: يُمنع المعرّف الثابت، ويُطلب `ON CONFLICT` على مفتاح أعمال.
--   هنا      : المعرّف الثابت **مطلوب**، لأنه ما يجعل الاختبار يتكرر بنفس النتيجة.
--
-- ── البنية الإلزامية ────────────────────────────────────────────────────────
--   القسم 1: التنظيف   — احذف ما ستُنشئه، ليستقلّ الاختبار عن ترتيب التشغيل
--   القسم 2: الإعداد   — أنشئ بياناتك بمعرّفات ثابتة
--   القسم 3: التحقق    — تأكد أن ما أنشأته صحيح
--
-- المرجع: supabase/docs/2026-10-12_guide_migrations-rules.md — القاعدة R-08.
-- ============================================================================

BEGIN;

-- ============================================================================
-- القسم 1 — التنظيف
-- ============================================================================
-- احذف بترتيب معاكس لترتيب الإنشاء، لأن المفاتيح الأجنبية تفرض الترتيب.
-- هذا يجعل تشغيل الملف أكثر من مرة بلا خطأ، ويجعله مستقلاً عن غيره.

DELETE FROM public.sales_invoice_items WHERE invoice_id = '11111111-1111-1111-1111-111111111111';
DELETE FROM public.sales_invoices      WHERE id         = '11111111-1111-1111-1111-111111111111';
DELETE FROM public.inventory           WHERE product_id = '22222222-2222-2222-2222-222222222222';
DELETE FROM public.products            WHERE id         = '22222222-2222-2222-2222-222222222222';
DELETE FROM public.customers           WHERE id         = '33333333-3333-3333-3333-333333333333';


-- ============================================================================
-- القسم 2 — الإعداد
-- ============================================================================
-- ── قواعد ───────────────────────────────────────────────────────────────────
--   1. معرّف ثابت لكل صف. استخدم نمطًا واضحًا: 1111…، 2222…، 3333…
--   2. تاريخ ثابت. لا تستخدم now().
--   3. أسماء تبدأ بـ test_ لتمييزها بسهولة عند التشخيص.
--   4. لا تعتمد على ملف من 03_samples.

-- عميل اختبار
INSERT INTO public.customers (id, name, phone, balance, credit_limit, is_active)
VALUES ('33333333-3333-3333-3333-333333333333', 'test_customer_one', '0000000', 0, 100000, true)
ON CONFLICT (id) DO NOTHING;

-- منتج اختبار
-- ملاحظة: الوحدة والتصنيف يُحلّان بالاسم من 01_system، لا بمعرّف ثابت،
-- لأن معرّفاتهما تُولَّد عند تشغيل النظام.
INSERT INTO public.products (id, sku, name, name_ar, unit_id, cost_price, sale_price,
                             is_active, item_nature, inventory_policy, costing_method)
VALUES (
  '22222222-2222-2222-2222-222222222222',
  'TEST-SKU-001',
  'test_product_one',
  'منتج اختبار',
  (SELECT id FROM public.units WHERE name = 'Piece'),
  100, 150, true, 'GOOD', 'TRACKED', 'MOVING_AVERAGE'
)
ON CONFLICT (id) DO NOTHING;

-- فاتورة اختبار بتاريخ ثابت
INSERT INTO public.sales_invoices (
  id, invoice_number, customer_id, subtotal, discount, tax, total, paid,
  payment_method, status, created_at
)
VALUES (
  '11111111-1111-1111-1111-111111111111',
  'TEST-INV-0001',
  '33333333-3333-3333-3333-333333333333',
  1000, 0, 0, 1000, 0,
  'credit', 'unpaid',
  '2026-01-01T00:00:00Z'::timestamptz
)
ON CONFLICT (id) DO NOTHING;


-- ============================================================================
-- القسم 3 — التحقق
-- ============================================================================
-- تأكد أن ما أنشأته موجود فعلًا، وإلا يفشل الملف بوضوح بدل أن يتسلسل خطأ
-- غامض إلى الاختبار.

DO $$
DECLARE
  v_missing text[] := ARRAY[]::text[];
BEGIN
  IF NOT EXISTS (SELECT 1 FROM public.customers
                  WHERE id = '33333333-3333-3333-3333-333333333333') THEN
    v_missing := v_missing || 'customer';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM public.products
                  WHERE id = '22222222-2222-2222-2222-222222222222') THEN
    v_missing := v_missing || 'product';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM public.sales_invoices
                  WHERE id = '11111111-1111-1111-1111-111111111111') THEN
    v_missing := v_missing || 'invoice';
  END IF;

  IF array_length(v_missing, 1) > 0 THEN
    RAISE EXCEPTION 'لم تُنشأ مثبتات الاختبار: %', array_to_string(v_missing, ', ');
  END IF;

  -- تنبيه: الوحدة يجب أن تكون موجودة، وإلا فشل إدخال المنتج أعلاه.
  IF NOT EXISTS (SELECT 1 FROM public.units WHERE name = 'Piece') THEN
    RAISE EXCEPTION 'وحدة «Piece» غير موجودة — شغّل seeds/01_system أولًا.';
  END IF;
END $$;

COMMIT;

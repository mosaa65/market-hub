-- ============================================================================
-- customer-template.sql.example — قالب الأرصدة الافتتاحية لعميل جديد
-- ============================================================================
--
-- ⚠️  انسخ هذا الملف باسم جديد، واملأه، وأبقِ النسخة المعبّأة خارج المستودع:
--       cp customer-template.sql.example acme-trading-2026.sql
--
--     وأضف seeds/02_company/*.sql إلى .gitignore.
--
-- ── الغرض ───────────────────────────────────────────────────────────────────
--   تحميل أرصدة عميل جديد عند بداية تشغيله: مخزون، ذمم، نقدية، رأس مال.
--
-- ── لماذا عبر دالة وليس INSERT مباشر؟ ───────────────────────────────────────
--   الدالة post_opening_balance() تفعل ثلاثة أشياء لا يفعلها INSERT:
--     1. ترفض الترحيل إن لم يتوازن المدين والدائن.
--     2. تكتب حركة المخزون وطبقة التكلفة لكل بند مخزون.
--     3. تحدّث دفتر العميل وذمم الموردين.
--
--   أما INSERT مباشر فيُنشئ مستندًا يبدو مُرحَّلًا بينما لا يعلم به أي جزء آخر
--   من النظام — وهي أسوأ حالة ممكنة، لأن الخطأ لا يظهر.
--
-- ── ما لا يجوز أن يحويه هذا الملف ───────────────────────────────────────────
--   * هوية الشركة (الاسم، العملة، الرقم الضريبي) — العميل يحرّرها من الإعدادات
--   * كلمات مرور أو مفاتيح — المستخدمون يُنشَؤون من التطبيق
--   * بيانات عميل آخر
--
-- المرجع: supabase/MIGRATIONS_RULES.md — القاعدتان R-02 و R-18.
-- ============================================================================

BEGIN;

-- ============================================================================
-- الخطوة 1 — استخرج معرّفات منشأتك الحقيقية
-- ============================================================================
-- شغّل هذه الاستعلامات واستبدل المعرّفات أدناه بالقيم الناتجة:
--
--   SELECT id, name, name_ar FROM public.warehouses;
--   SELECT id, sku,   name_ar FROM public.products;
--   SELECT id, name            FROM public.customers;
--
-- أو اترك القيم كما هي وستفشل الدالة برسالة واضحة — وهذا أفضل من خطأ صامت.

DO $$
DECLARE
  v_doc uuid;
BEGIN

  -- ==========================================================================
  -- الخطوة 2 — إنشاء المستند كمسودة
  -- ==========================================================================
  -- ── الأقسام وأطرافها ──────────────────────────────────────────────────────
  --   STOCK, RECEIVABLE, CASH, BANK, ASSET  →  مدين
  --   PAYABLE, LIABILITY, CAPITAL           →  دائن
  --
  --   الطرف **يُشتقّ من القسم** ولا تدخله. هذا يمنع خطأ كتابة «أصل على الجانب
  --   الدائن» — وهو الخطأ الذي وُجد فحص التوازن لاكتشافه.
  --
  -- ── الأرقام أدناه مثال ────────────────────────────────────────────────────
  --   المجموع: 400,000 مدين مقابل 400,000 دائن. استبدلها بأرقامك.
  -- ==========================================================================
  v_doc := public.create_opening_balance(
    _effective_date => '2026-01-01',   -- تاريخ بداية التشغيل الفعلي
    _lines => '[
      {"section":"STOCK",
       "product_id":"00000000-0000-0000-0000-000000000000",
       "warehouse_id":"00000000-0000-0000-0000-000000000000",
       "quantity":1000, "unit_cost":250, "amount":250000,
       "description":"رصيد افتتاحي - مخزون أول المدة"},

      {"section":"RECEIVABLE",
       "customer_id":"00000000-0000-0000-0000-000000000000",
       "amount":50000,
       "description":"رصيد افتتاحي - ذمم عميل"},

      {"section":"CASH",
       "amount":100000,
       "description":"رصيد افتتاحي - النقدية بالصندوق"},

      {"section":"CAPITAL",
       "amount":400000,
       "description":"رأس المال"}
    ]'::jsonb,
    _notes => 'الأرصدة الافتتاحية — اسم العميل — 2026-01-01'
  );

  -- ==========================================================================
  -- الخطوة 3 — التحقق من التوازن قبل الترحيل
  -- ==========================================================================
  -- is_balanced محسوبة من البنود. إن كانت false فالأرقام لا تتوازن، و
  -- post_opening_balance سيرفض الترحيل. نكشف ذلك هنا برسالة واضحة.
  -- ==========================================================================
  PERFORM 1
     FROM public.opening_balance_summary
    WHERE id = v_doc AND is_balanced;

  IF NOT FOUND THEN
    RAISE EXCEPTION
      'القيد الافتتاحي غير متوازن. صحّح البنود قبل الترحيل. معرّف المستند: %', v_doc;
  END IF;

  -- ==========================================================================
  -- الخطوة 4 — الترحيل
  -- ==========================================================================
  -- هنا تُكتب حركات المخزون وطبقات التكلفة وقيود الدفاتر.
  -- ==========================================================================
  PERFORM public.post_opening_balance(v_doc);

  RAISE NOTICE 'تم ترحيل القيد الافتتاحي: %', v_doc;
END $$;

-- ============================================================================
-- الخطوة 5 — المعاينة قبل التأكيد
-- ============================================================================
-- ⚠️  اقرأ هذا الجدول بتمعّن. القيد الافتتاحي يُبنى عليه كل تقييم لاحق،
--     وخطؤه مكلف جدًا في التصحيح.
--
-- ⚠️  خطر معروف: post_opening_balance() ترحّل المخزون والذمم فقط. أما
--     CASH و BANK و ASSET و LIABILITY و CAPITAL فتُسجَّل ولا تُرحَّل إلى
--     دفتر الأستاذ. تحقق من أثر المستند على ميزان المراجعة بعد الترحيل.
--     التفصيل في ACCOUNTING_GAPS_AUDIT_REPORT.md.
-- ============================================================================

SELECT document_number,
       status,
       total_assets,
       total_liabilities,
       capital_required,
       is_balanced
  FROM public.opening_balance_summary
 ORDER BY created_at DESC
 LIMIT 1;

-- إن كان الناتج صحيحًا، أكّد:
COMMIT;

-- وإن كان فيه خطأ، ألغِ كل ما سبق:
-- ROLLBACK;
